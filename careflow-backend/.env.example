# Copy this file to .env and fill values in

# Used to sign JWT tokens - change this to a long random string in production
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite by default (zero-config). To use careflow_schema.sql with MySQL 8:
# 1. Run the SQL file: mysql -u root -p < ../careflow_schema.sql
# 2. Set a URL like the following (URL-encode special password characters):
# DATABASE_URL=mysql+pymysql://careflow_user:password@127.0.0.1:3306/careflow
DATABASE_URL=sqlite:///./careflow.db

# Required for the AI Assistant to be backend-connected (patient search,
# vitals/record updates, appointments, lab reports, prescriptions, billing,
# report analysis). Get a key at https://aistudio.google.com/apikey.
# Without a key, /api/ai-assistant/chat still responds, but only with a
# minimal rule-based fallback - it will not search or touch the database.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Comma separated list of origins allowed to call this API from the browser.
# Includes the origins Capacitor's WebView sends from the mobile app
# (https://localhost) - keep those even if you add your own web domain.
# The "null" origin (sandboxed iframes / file:// / data: URIs) is never
# allowed, even if listed here - see app/config.py.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:5501,https://localhost,capacitor://localhost

# Set to false in production. When false, the app refuses to start unless
# SECRET_KEY is a real random value and CORS_ORIGINS has been set to your
# real frontend origin(s) - see app/config.py's fail-fast check.
DEBUG=true
